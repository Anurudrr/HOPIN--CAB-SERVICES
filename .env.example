# Supabase (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (Required for payments)
STRIPE_SECRET_KEY=sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_... or pk_test_...

# Mapbox (Optional - for better maps)
VITE_MAPBOX_TOKEN=pk.your-mapbox-token

# Push Notifications - VAPID Keys (Required for push)
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# Supabase Service Role (Required for edge functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio (Required for SMS/Phone verification)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_VERIFY_SID=VAxxxxxxxxxxxx

# Email - Resend (Preferred) or SendGrid
RESEND_API_KEY=re_xxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=HopIn

# Analytics (Optional)
ANALYTICS_PROVIDER=mixpanel|amplitude|custom
MIXPANEL_TOKEN=your-mixpanel-token
AMPLITUDE_API_KEY=your-amplitude-key
ANALYTICS_ENDPOINT=https://your-analytics-endpoint.com/events
VITE_ENABLE_ANALYTICS=true

# Sentry (Optional - error tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# App Configuration
VITE_APP_URL=https://yourdomain.com
VITE_APP_NAME=HopIn

# Feature Flags
VITE_ENABLE_POOLING=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_PUSH=true
VITE_ENABLE_TRACKING=true
VITE_ENABLE_SOS=true
VITE_ENABLE_SCHEDULED=true
VITE_ENABLE_MULTI_STOP=true
VITE_ENABLE_REFERRALS=true
VITE_ENABLE_PROMO_CODES=true
VITE_ENABLE_PHONE_VERIFY=true
VITE_ENABLE_EMAIL=true